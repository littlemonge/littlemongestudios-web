---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, ui } from '../i18n/ui.js';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang].sonar;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/sonar/og.png', Astro.site).href;
const cols = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
---
<BaseLayout title={t.title} description={t.description} bleed bodyClass="sonar-page">
  <Fragment slot="head">
    <link rel="stylesheet" href="/sonar/sonar.css?v=3" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Little Monge Studios" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={ogImage} />
  </Fragment>

  <div class="sonar-app">
    <div class="wrap">
      <header class="top">
        <div class="brand">
          <h1 class="wordmark">SONAR</h1>
          <span class="tagline">{t.tagline}</span>
        </div>
        <div class="issue" id="issue">&nbsp;</div>
      </header>

      <noscript><p class="full">{t.noscript}</p></noscript>

      <section class="panel full" id="prelaunch" hidden>
        <h2>{t.prelaunchTitle}</h2>
        <p>{t.prelaunchBefore} <strong id="launch-date"></strong>{t.prelaunchAfter}</p>
        <p class="countdown" id="launch-countdown" role="timer"></p>
      </section>

      <div class="game-grid full" id="game" hidden>
        <section class="board-col" aria-label={t.boardSection}>
          <div class="gauges">
            <span class="gauge-label">{t.charges}</span>
            <span class="readout" id="readout">&nbsp;</span>
            <div class="charges" id="charges" aria-hidden="true"></div>
          </div>
          <div class="board-wrap">
            <div class="coords-x" aria-hidden="true">{cols.map((c) => <span>{c}</span>)}</div>
            <div class="coords-y" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7].map((n) => <span>{n}</span>)}</div>
            <div class="board-frame">
              <div class="board" id="board" role="group" aria-label={t.boardGroup}></div>
            </div>
          </div>
          <div class="controls">
            <div class="mode" role="group" aria-label={t.modeGroup}>
              <button type="button" id="mode-ping" aria-pressed="true">{t.modePing}</button>
              <button type="button" id="mode-mark" aria-pressed="false">{t.modeMark}</button>
            </div>
            <p class="hint" id="hint">{t.hint}</p>
          </div>
          <ul class="legend" aria-label={t.legend}>
            <li><span class="sw sw-hit"></span>{t.legendHit}</li>
            <li><span class="sw sw-d1"></span>{t.legendD1}</li>
            <li><span class="sw sw-d2"></span>{t.legendD2}</li>
            <li><span class="sw sw-d3"></span>{t.legendD3}</li>
          </ul>
          <div class="sr-only" id="sr-status" role="status" aria-live="polite"></div>
        </section>

        <aside class="log">
          <section class="panel" id="result-panel" hidden aria-label={t.resultLabel}>
            <h2>{t.dive}</h2>
            <p class="result-title" id="result-title"></p>
            <div class="result-sub" id="result-sub"></div>
            <pre class="share-box" id="share-box"></pre>
            <div class="row">
              <button type="button" class="btn" id="share-btn" hidden>{t.share}</button>
              <button type="button" class="btn" id="copy-btn">{t.copy}</button>
              <span class="countdown muted" id="countdown" role="timer"></span>
            </div>
          </section>

          <details class="panel how" id="how" open>
            <summary><h2>{t.howTitle}</h2></summary>
            <ol class="rules">
              {t.rules.map((rule) => <li set:html={rule} />)}
            </ol>
            <p class="small muted">{t.openingNote}</p>
          </details>

          <section class="panel" aria-label={t.record}>
            <h2>{t.logbook}</h2>
            <div class="stats" id="stats"></div>
            <div class="shields" id="shields"></div>
            <div class="dist" id="dist"></div>
            <p class="small muted" id="storage-note" hidden>{t.storageNote}</p>
          </section>

          <section class="panel">
            <h2>{t.weekTitle}</h2>
            <p class="small muted">{t.weekNote}</p>
            <div class="mosaic-wrap"><canvas id="mosaic" width="700" height="300" role="img" aria-label={t.weekAlt}></canvas></div>
            <div class="week-labels" id="week-labels" aria-hidden="true"></div>
          </section>

          <details class="debug" id="debug" hidden>
            <summary>Debug tools</summary>
            <div class="row">
              <label for="date-pick" class="small">Play another date</label>
              <input type="date" id="date-pick" />
              <button type="button" class="btn ghost" id="today-btn">Today</button>
            </div>
            <div class="row">
              <button type="button" class="btn ghost" id="reset-btn">Reset this day</button>
              <button type="button" class="btn ghost" id="reveal-btn" aria-pressed="false">Show figure</button>
              <button type="button" class="btn ghost" id="wipe-btn">Clear debug data</button>
            </div>
            <p class="small muted">Debug mode keeps its own save (<code>sonar:v1:debug</code>) and never touches the real record.</p>
          </details>
        </aside>
      </div>

      <p class="foot full">{t.foot}</p>
    </div>
    <div class="toast" id="toast" hidden></div>
  </div>

  <script is:inline defer src="/sonar/engine.js"></script>
  <script is:inline defer src="/sonar/sonar.js"></script>
</BaseLayout>
