---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects.js';

const project = projects.find((p) => p.slug === 'squadfire');
---
<BaseLayout title="Squadfire" description="Squadfire, un videojuego de Little Monge Studios">
  <h1>Squadfire</h1>
  <p class="muted">{project.tagline}</p>

  <p>
    <!-- TODO: sustituir por una descripción real de qué es Squadfire
         (género, mecánicas principales, para quién es) cuando la tengáis definida. -->
    Squadfire es el próximo juego de Little Monge Studios, actualmente en desarrollo.
    Aquí iremos añadiendo más detalles a medida que avance el proyecto.
  </p>

  <h2>Capturas</h2>
  <p class="muted">Próximamente — añadiremos capturas de pantalla cuando estén disponibles.</p>

  <h2>Descarga</h2>
  {project.storeUrl ? (
    <a href={project.storeUrl}><img src="/images/google-play-badge-es.png" alt="Disponible en Google Play" style="height: 54px;" /></a>
  ) : (
    <div class="badge-wrap">
      <img src="/images/google-play-badge-es.png" alt="Disponible en Google Play (próximamente)" />
      <span class="badge-label">Próximamente</span>
    </div>
  )}
</BaseLayout>
