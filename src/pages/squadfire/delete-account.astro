---
import BaseLayout from '../../layouts/BaseLayout.astro';

const subject = encodeURIComponent('Squadfire — Delete my account');
const body = encodeURIComponent(
  'Hi,\n\nI would like to delete my Squadfire account and all its data.\n\nUsername: \nInvite code (if I still have it): \n\nThanks.'
);
const mailtoHref = `mailto:team@littlemongestudios.com?subject=${subject}&body=${body}`;
---
<BaseLayout
  title="Squadfire — Delete your account"
  description="How to delete your Squadfire account and data"
>
  <h1>Squadfire — Delete your account</h1>
  <p class="muted">Last updated: 2026-10-03</p>

  <p>
    Squadfire is developed by an individual developer operating as
    "Little Monge Studios" (Spain).
  </p>

  <h2>Option 1 — delete it in the app (fastest)</h2>
  <ol>
    <li>Open Squadfire and go to <strong>Profile → Settings ⚙️</strong>.</li>
    <li>Scroll down and tap <strong>Delete my account</strong>.</li>
    <li>Confirm — deletion happens immediately and can't be undone.</li>
  </ol>

  <h2>Option 2 — without access to the app</h2>
  <p>
    If you've lost access to the app (uninstalled it, switched phones,
    etc.), email
    <a href="mailto:team@littlemongestudios.com">team@littlemongestudios.com</a>
    from any address asking to delete your Squadfire account, and
    include your username and, if you still have it, your invite code
    (Profile → your invite code) so we can find the right account.
    We'll confirm once it's deleted, within 30 days.
  </p>

  <a class="button" href={mailtoHref}>Request deletion by email</a>

  <h2>What gets deleted</h2>
  <p>Deleting your account removes, immediately and permanently:</p>
  <ul>
    <li>Your username, avatar and profile style, and your account identifier</li>
    <li>Your sign-in, including a linked Google account</li>
    <li>Your check-in history, current and best streak, and time zone</li>
    <li>Your streak freezes and purchase records</li>
    <li>Your points, the cosmetics you unlocked or bought, achievements and monthly bonus-wheel results</li>
    <li>Your streak goals and streak wagers</li>
    <li>Your friends, invite code and squad memberships (squads you created pass to another member; if nobody is left, they're deleted)</li>
    <li>Your notification settings and device push tokens</li>
    <li>The people you blocked and the reports you sent</li>
    <li>The in-app usage events tied to your account</li>
  </ul>
  <p>
    This can't be undone. Squadfire doesn't keep a recovery window. Our
    hosting provider's encrypted backups expire automatically after a
    limited time.
  </p>
</BaseLayout>
