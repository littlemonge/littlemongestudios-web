---
import { projects } from '../data/projects.js';
import { getLangFromUrl, stripLang, localePath, languages, ui } from '../i18n/ui.js';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang].nav;
const basePath = stripLang(Astro.url.pathname);
---
<header class="site-header">
  <a class="wordmark" href={localePath(lang, '/')}>Little Monge Studios</a>
  <div class="header-right">
    <nav>
      <a href={localePath(lang, '/')}>{t.home}</a>
      {projects.map((p) => <a href={localePath(lang, `/${p.slug}/`)}>{p.name}</a>)}
      <a href={localePath(lang, '/contact/')}>{t.contact}</a>
    </nav>
    <div class="lang-switch" role="group" aria-label={t.switchLabel}>
      {Object.entries(languages).map(([code, label], i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          <a
            href={localePath(code, basePath)}
            lang={code}
            hreflang={code}
            aria-label={label}
            aria-current={code === lang ? 'true' : undefined}
          >{code.toUpperCase()}</a>
        </>
      ))}
    </div>
  </div>
</header>
