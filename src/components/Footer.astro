---
import { projects } from '../data/projects.js';
import { getLangFromUrl, localePath, ui } from '../i18n/ui.js';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang].footer;
const year = new Date().getFullYear();
const legalProjects = projects.filter((p) => p.legalPages);
---
<footer class="site-footer">
  <div class="inner">
    <div>
      <div class="wordmark">Little Monge Studios</div>
      <div style="margin-top: 0.75rem;">© {year} Little Monge Studios</div>
      <div style="margin-top: 0.25rem;">
        <a href="mailto:team@littlemongestudios.com">team@littlemongestudios.com</a>
      </div>
    </div>
    <div class="footer-links">
      {legalProjects.map((p) => (
        <>
          <a href={localePath(lang, `/${p.slug}/terms/`)}>{p.name} — {t.terms}</a>
          <a href={localePath(lang, `/${p.slug}/privacy/`)}>{p.name} — {t.privacy}</a>
          <a href={localePath(lang, `/${p.slug}/delete-account/`)}>{p.name} — {t.delete}</a>
        </>
      ))}
    </div>
    <div class="social-placeholder">{t.social}</div>
  </div>
</footer>
